# Copy this file to `.env` and fill in the values from your Firebase project:
#   Firebase console → Project settings → Your apps → SDK setup and configuration.
# The app runs entirely on localStorage until these are set.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to seed the demo + admin accounts into Firebase Auth on boot.
# Off by default — demo login falls back to local accounts when Firebase Auth
# is unavailable, and leaving this off avoids 400 spam from identitytoolkit.
VITE_SEED_DEMO_AUTH=false
