// Phase 19 — Firestore security rules.
//
// Principles:
//  - Signed-in users only ever touch THEIR OWN documents.
//  - Money-critical fields (balance, bet status, transaction amounts)
//    are never writable from the browser; only trusted backend logic
//    (Cloud Functions / admin SDK) may change them.
//  - Match catalogue is public-read, admin-write.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Users may update their own profile, but never promote themselves,
      // suspend themselves or touch balances stored here.
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.isSuspended == resource.data.isSuspended
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance', 'walletBalance']);
      allow create: if isOwner(userId);
      allow delete: if isAdmin();
    }

    match /wallets/{walletId} {
      allow read: if isOwner(walletId) || isAdmin();
      // No client-side balance changes. Trusted backend only.
      allow create: if isOwner(walletId)
        && request.resource.data.balance == 0;
      allow update: if false;
      allow delete: if false;
    }

    match /bets/{betId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // Users may create bets; stake deduction is validated by backend.
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.status == 'pending'
        && request.resource.data.settledAt == null;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /betSelections/{selectionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if signedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /transactions/{txId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false; // backend writes ledger entries
    }

    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /markets/{marketId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sports/{sportId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, update: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow delete: if false;
    }
  }
}
