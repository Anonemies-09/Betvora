// BETVORA Firestore security rules.
//
// Model:
//  • Firebase Authentication proves identity; the profile in `users/{uid}`
//    carries the role.
//  • Players own their profile, wallet, bets, deposit/withdrawal requests and
//    notifications.
//  • Admins can read everything and manage accounts/content.
//  • Agents can work bets and payment requests but cannot read the user
//    directory, promotions or banners.
//  • The match catalogue, promotions and banners are public reads.
//
// Note: balances are still trusted from the client (there is no backend), so
// these rules prevent cross-user tampering but cannot stop a determined user
// from editing their own wallet with devtools. Moving money to a server API is
// the follow-up step for full tamper resistance.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(id) {
      return signedIn() && uid() == id;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isAdmin() {
      return signedIn() && myProfile().role == 'admin';
    }

    function isStaff() {
      return signedIn()
        && (myProfile().role == 'admin' || myProfile().role == 'agent');
    }

    function isStaffEmail() {
      return signedIn() && request.auth.token.email in [
        'admin1@betvora.app',
        'admin2@betvora.app',
        'agent@betvora.app'
      ];
    }

    function staffRoleForMe() {
      return request.auth.token.email == 'agent@betvora.app' ? 'agent' : 'admin';
    }

    // ---------------------------------------------------------------- users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // New players sign themselves up with role 'user'. The three fixed staff
      // identities may create their own profile with their provisioned role.
      allow create: if isOwner(userId)
        && (
          (request.resource.data.role == 'user'
            && request.resource.data.isSuspended == false)
          || (isStaffEmail() && request.resource.data.role == staffRoleForMe())
        );

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && isStaffEmail()
          && request.resource.data.role == staffRoleForMe()
          && request.resource.data.isSuspended == resource.data.isSuspended
        )
        || (
          isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.isSuspended == resource.data.isSuspended
        );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------- wallets
    match /wallets/{walletId} {
      allow read: if isOwner(walletId) || isStaff();
      allow write: if isOwner(walletId) || isStaff();
    }

    // ----------------------------------------------------------------- bets
    match /bets/{betId} {
      allow read: if signedIn()
        && (isOwner(resource.data.userId) || isStaff());
      allow create: if signedIn()
        && (isOwner(request.resource.data.userId) || isStaff());
      // Settlement, voids and admin-created bets are staff actions.
      allow update, delete: if isStaff();
    }

    // ------------------------------------------------------ deposit requests
    match /depositRequests/{requestId} {
      allow read: if signedIn()
        && (isOwner(resource.data.userId) || isStaff());
      allow create: if signedIn()
        && isOwner(request.resource.data.userId)
        && request.resource.data.status == 'pending';
      allow update, delete: if isStaff();
    }

    // --------------------------------------------------- withdrawal requests
    match /withdrawalRequests/{requestId} {
      allow read: if signedIn()
        && (isOwner(resource.data.userId) || isStaff());
      allow create: if signedIn()
        && isOwner(request.resource.data.userId)
        && request.resource.data.status == 'pending';
      allow update, delete: if isStaff();
    }

    // --------------------------------------------------------- notifications
    match /notifications/{notificationId} {
      allow read: if signedIn() && isOwner(resource.data.userId);
      allow create: if signedIn()
        && (isOwner(request.resource.data.userId) || isStaff());
      allow update: if signedIn()
        && (isOwner(resource.data.userId) || isStaff());
      allow delete: if signedIn()
        && (isOwner(resource.data.userId) || isStaff());
    }

    // -------------------------------------------------------- public content
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
